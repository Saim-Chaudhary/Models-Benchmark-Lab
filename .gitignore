# Environment variables / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# uv / virtual environments
.venv/
venv/
env/

# Streamlit
.streamlit/secrets.toml

# Project-generated data (safe to regenerate, shouldn't be committed)
benchmark_results.csv
benchmark_history.json

# OS-specific junk files
.DS_Store
Thumbs.db

# Editor/IDE settings
.vscode/
.idea/
*.swp

# uv lock file note:
# uv.lock IS generally recommended to commit for reproducible installs,
# so it is intentionally NOT ignored here.